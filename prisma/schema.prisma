generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users       User[]
  trucks      Truck[]
  drivers     Driver[]
  parties     Party[]
  trips       Trip[]
  documents   TruckDocument[]
  ledger      LedgerEvent[]
  files       StoredFile[]
  proofs      Proof[]
  fuels       FuelFill[]
  jobs        WorkshopJob[]
  tyres       Tyre[]
  invoices    Invoice[]
  quotes      Quote[]
  assignments Assignment[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  name         String
  role         String
  driverId     String?  @map("driver_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Driver {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  phone         String
  dlNumber      String    @map("dl_number")
  dlExpiry      DateTime  @map("dl_expiry") @db.Date
  badgeNumber   String?   @map("badge_number")
  badgeExpiry   DateTime? @map("badge_expiry") @db.Date
  monthlySalary Decimal   @default(0) @map("monthly_salary") @db.Decimal(12, 2)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  users       User[]
  trips       Trip[]
  assignments Assignment[]

  @@index([tenantId])
  @@map("drivers")
}

model Truck {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  regNo        String   @map("reg_no")
  make         String
  model        String
  capacityTons Decimal  @map("capacity_tons") @db.Decimal(6, 2)
  wheels       Int
  status       String
  expectedKmpl Decimal  @map("expected_kmpl") @db.Decimal(5, 2)
  odometerKm   Int      @default(0) @map("odometer_km")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  documents   TruckDocument[]
  trips       Trip[]
  fuels       FuelFill[]
  jobs        WorkshopJob[]
  tyres       Tyre[]
  assignments Assignment[]

  @@unique([tenantId, regNo])
  @@index([tenantId])
  @@map("trucks")
}

model TruckDocument {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  truckId   String   @map("truck_id") @db.Uuid
  docType   String   @map("doc_type")
  docNumber String   @map("doc_number")
  expiresOn DateTime @map("expires_on") @db.Date

  tenant Tenant @relation(fields: [tenantId], references: [id])
  truck  Truck  @relation(fields: [truckId], references: [id])

  @@index([tenantId])
  @@index([truckId])
  @@map("truck_documents")
}

model Party {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  kind     String
  gstin    String?
  phone    String?
  city     String?

  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  quotes         Quote[]
  invoices       Invoice[]
  customerTrips  Trip[]    @relation("TripCustomer")
  consignorTrips Trip[]    @relation("TripConsignor")
  consigneeTrips Trip[]    @relation("TripConsignee")

  @@index([tenantId])
  @@map("parties")
}

model Quote {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  partyId     String   @map("party_id") @db.Uuid
  origin      String
  destination String
  amount      Decimal  @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  party  Party  @relation(fields: [partyId], references: [id])

  @@index([tenantId])
  @@map("quotes")
}

model Trip {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  number      String
  status      String
  truckId     String    @map("truck_id") @db.Uuid
  driverId    String    @map("driver_id") @db.Uuid
  customerId  String?   @map("customer_id") @db.Uuid
  consignorId String?   @map("consignor_id") @db.Uuid
  consigneeId String?   @map("consignee_id") @db.Uuid
  origin      String
  destination String
  goods       String
  weightTons  Decimal   @map("weight_tons") @db.Decimal(10, 2)
  rateBasis   String    @map("rate_basis")
  rate        Decimal   @db.Decimal(12, 2)
  freight     Decimal   @db.Decimal(12, 2)
  lrNumber    String?   @map("lr_number")
  sealNumber  String?   @map("seal_number")
  polOtp      String?   @map("pol_otp")
  podOtp      String?   @map("pod_otp")
  polOtpOk    Boolean   @default(false) @map("pol_otp_ok")
  podOtpOk    Boolean   @default(false) @map("pod_otp_ok")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  truck       Truck        @relation(fields: [truckId], references: [id])
  driver      Driver       @relation(fields: [driverId], references: [id])
  customer    Party?       @relation("TripCustomer", fields: [customerId], references: [id])
  consignor   Party?       @relation("TripConsignor", fields: [consignorId], references: [id])
  consignee   Party?       @relation("TripConsignee", fields: [consigneeId], references: [id])
  proofs      Proof[]
  fuels       FuelFill[]
  invoices    Invoice[]
  assignments Assignment[]

  @@unique([tenantId, number])
  @@unique([tenantId, lrNumber])
  @@index([tenantId])
  @@map("trips")
}

model Proof {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  kind      String
  fileId    String   @map("file_id") @db.Uuid
  capture   String
  note      String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  trip   Trip       @relation(fields: [tripId], references: [id])
  file   StoredFile @relation(fields: [fileId], references: [id])

  @@index([tenantId])
  @@index([tripId])
  @@map("proofs")
}

model StoredFile {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  sha256    String
  bytes     Int
  mime      String
  label     String
  path      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  proofs Proof[]

  @@index([tenantId])
  @@index([tenantId, sha256])
  @@map("stored_files")
}

model FuelFill {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  truckId   String   @map("truck_id") @db.Uuid
  tripId    String?  @map("trip_id") @db.Uuid
  litres    Decimal  @db.Decimal(10, 2)
  amount    Decimal  @db.Decimal(12, 2)
  odometer  Int
  station   String
  method    String
  status    String
  kmpl      Decimal? @db.Decimal(6, 2)
  flagged   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  truck  Truck  @relation(fields: [truckId], references: [id])
  trip   Trip?  @relation(fields: [tripId], references: [id])

  @@index([tenantId])
  @@map("fuel_fills")
}

model WorkshopJob {
  id       String    @id @default(uuid()) @db.Uuid
  tenantId String    @map("tenant_id") @db.Uuid
  truckId  String    @map("truck_id") @db.Uuid
  title    String
  dueOn    DateTime? @map("due_on") @db.Date
  dueKm    Int?      @map("due_km")
  status   String
  cost     Decimal   @default(0) @db.Decimal(12, 2)
  vendor   String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  truck  Truck  @relation(fields: [truckId], references: [id])

  @@index([tenantId])
  @@map("workshop_jobs")
}

model Tyre {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  truckId  String @map("truck_id") @db.Uuid
  serial   String
  position String
  kmRun    Int    @map("km_run")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  truck  Truck  @relation(fields: [truckId], references: [id])

  @@index([tenantId])
  @@map("tyres")
}

model Invoice {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  number      String
  tripId      String?  @map("trip_id") @db.Uuid
  partyId     String   @map("party_id") @db.Uuid
  taxable     Decimal  @db.Decimal(12, 2)
  gstMode     String   @map("gst_mode")
  gstRate     Decimal  @map("gst_rate") @db.Decimal(5, 2)
  gstAmount   Decimal  @map("gst_amount") @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  itcEligible Boolean  @map("itc_eligible")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  trip   Trip?  @relation(fields: [tripId], references: [id])
  party  Party  @relation(fields: [partyId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("invoices")
}

model Assignment {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  driverId  String    @map("driver_id") @db.Uuid
  truckId   String    @map("truck_id") @db.Uuid
  tripId    String?   @map("trip_id") @db.Uuid
  startedAt DateTime  @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])
  truck  Truck  @relation(fields: [truckId], references: [id])
  trip   Trip?  @relation(fields: [tripId], references: [id])

  @@index([tenantId])
  @@map("assignments")
}

model LedgerEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  seq        Int
  prevHash   String   @map("prev_hash")
  hash       String
  eventType  String   @map("event_type")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  actorId    String?  @map("actor_id") @db.Uuid
  payload    Json
  fileHashes String[] @map("file_hashes")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, seq])
  @@index([tenantId])
  @@map("ledger_events")
}
