# Runtime connection. This role must not bypass row-level security.
DATABASE_URL=postgresql://mighty_app:mighty-app-local@127.0.0.1:5432/mighty_movers

# Table owner used only for migrations, seed, and the tamper test restore.
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mighty_movers

SESSION_SECRET=replace-with-a-long-random-string
FIELD_ENCRYPTION_KEY=replace-with-a-long-random-string

# Optional. When unset, Zoho pushes are simulated and the daily summary stays in data/outbox.
# ZOHO_ORG_ID=
# ZOHO_ACCESS_TOKEN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=desk@mighty-movers.example
