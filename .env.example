# Pooled runtime URL. On Neon or Supabase this is the pooler host.
# Add ?pgbouncer=true&connection_limit=1 on a transaction-mode pooler.
# This role must be mighty_app and must not bypass row-level security.
DATABASE_URL=postgresql://mighty_app:mighty-app-local@127.0.0.1:5432/mighty_movers

# Direct owner URL used by Prisma migrate. Not the pooler.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/mighty_movers

# Local alias used by the tamper test. Set it to the same value as DIRECT_URL.
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mighty_movers

SESSION_SECRET=replace-with-a-long-random-string
FIELD_ENCRYPTION_KEY=replace-with-a-long-random-string

# Required in production. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=replace-with-a-long-random-string

# Used only by prisma/seed-production.ts. Never commit a real value.
# OWNER_PASSWORD=
# OWNER_EMAIL=owner@mighty-movers.example
# OWNER_NAME=Owner

# Object storage. Production refuses local disk. Set one of these groups.
# Vercel Blob:
# BLOB_READ_WRITE_TOKEN=
# S3-compatible (Cloudflare R2, Supabase storage S3, AWS):
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Zoho Books. When both are unset, invoice push is simulated.
# ZOHO_ORG_ID=
# ZOHO_ACCESS_TOKEN=
# Create a Self Client at https://api-console.zoho.com, add the ZohoBooks.invoices.CREATE scope,
# exchange the grant token for an access token, and put the Books organization id in ZOHO_ORG_ID.

# SMTP. When SMTP_HOST is unset, mail is stored in the outbox.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=desk@mighty-movers.example

# WhatsApp Cloud API. When unset, LR shares are stored in the outbox.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# MSG91 OTP. When unset, consignee OTPs stay in the server log and on the driver phone in development.
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER=
